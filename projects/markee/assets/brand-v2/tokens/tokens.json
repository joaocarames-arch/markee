{
  "$schema": "https://schemas.designtokens.org/format.json",
  "name": "markee/v2",
  "description": "Design tokens for markee wordmark and UI. Sora Bold (OFL 1.1) wordmark in paths only. Green #6EE7A8 is the brand accent.",
  "color": {
    "ink": {
      "$value": "#08090A",
      "$type": "color",
      "$description": "Primary background; text on light surfaces."
    },
    "charcoal": {
      "$value": "#111214",
      "$type": "color",
      "$description": "Secondary background."
    },
    "surface": {
      "$value": "#1A1C1F",
      "$type": "color",
      "$description": "Cards, panels."
    },
    "text-primary": {
      "$value": "#E8E8E8",
      "$type": "color",
      "$description": "Body text on dark surfaces."
    },
    "text-secondary": {
      "$value": "#8A8D93",
      "$type": "color",
      "$description": "Captions, metadata on dark surfaces."
    },
    "accent": {
      "$value": "#6EE7A8",
      "$type": "color",
      "$description": "Brand accent. Used as graphic accent and dark-mode interactive color."
    },
    "accent-hover": {
      "$value": "#86EFAC",
      "$type": "color",
      "$description": "Hover state on dark surfaces."
    },
    "accent-pressed": {
      "$value": "#0A7F57",
      "$type": "color",
      "$description": "Pressed state. AA ≥ 7.0 on ink."
    },
    "danger": {
      "$value": "#E05252",
      "$type": "color",
      "$description": "Errors. AA 5.22 on ink."
    },
    "success": {
      "$value": "#4ADE80",
      "$type": "color",
      "$description": "Confirmations. AAA 11.44 on ink."
    },
    "warning": {
      "$value": "no-color",
      "$type": "color",
      "$description": "Warning é estado de UI sem cor própria. Comunicado por ícone + texto sobre ink/charcoal/surface, com texto primário. Política: zero âmbar."
    },
    "white": {
      "$value": "#FFFFFF",
      "$type": "color",
      "$description": "Pure white."
    },
    "light-grey": {
      "$value": "#F5F5F5",
      "$type": "color",
      "$description": "Light surface for light variant demo."
    }
  },
  "typography": {
    "wordmark": {
      "$value": {
        "fontFamily": "Sora Bold",
        "fontWeight": 700,
        "fontSource": "Google Fonts",
        "fontLicense": "OFL-1.1",
        "delivery": "SVG paths only",
        "fontFile": "Sora-Bold.ttf",
        "upm": 1000,
        "capHeight": 730,
        "xHeight": 534
      },
      "$type": "typography"
    },
    "ui-heading": {
      "$value": {
        "fontFamily": "Inter",
        "fontWeight": 600,
        "fontSize": "32px"
      },
      "$type": "typography"
    },
    "ui-body": {
      "$value": {
        "fontFamily": "Inter",
        "fontWeight": 400,
        "fontSize": "16px"
      },
      "$type": "typography"
    },
    "ui-mono": {
      "$value": {
        "fontFamily": "JetBrains Mono",
        "fontWeight": 400,
        "fontSize": "14px"
      },
      "$type": "typography"
    }
  },
  "spacing": {
    "xs": {
      "$value": "4px",
      "$type": "dimension"
    },
    "sm": {
      "$value": "8px",
      "$type": "dimension"
    },
    "md": {
      "$value": "16px",
      "$type": "dimension"
    },
    "lg": {
      "$value": "24px",
      "$type": "dimension"
    },
    "xl": {
      "$value": "32px",
      "$type": "dimension"
    },
    "2xl": {
      "$value": "48px",
      "$type": "dimension"
    }
  },
  "radius": {
    "sm": {
      "$value": "6px",
      "$type": "dimension"
    },
    "md": {
      "$value": "10px",
      "$type": "dimension"
    },
    "lg": {
      "$value": "16px",
      "$type": "dimension"
    },
    "xl": {
      "$value": "24px",
      "$type": "dimension"
    }
  },
  "logo": {
    "clearspace": {
      "$value": "1x x-height",
      "$type": "dimension"
    },
    "minHeightPx": {
      "$value": "24px",
      "$type": "dimension"
    },
    "minHeightLowerLimitPx": {
      "$value": "16px",
      "$type": "dimension"
    },
    "accentOnLastGlyph": {
      "$value": true,
      "$type": "boolean"
    },
    "accentColor": {
      "$value": "#6EE7A8",
      "$type": "color"
    },
    "pathsOnly": {
      "$value": true,
      "$type": "boolean"
    },
    "noSymbol": {
      "$value": true,
      "$type": "boolean"
    },
    "noRadar": {
      "$value": true,
      "$type": "boolean"
    },
    "noPictogram": {
      "$value": true,
      "$type": "boolean"
    }
  },
  "shadow": {
    "sm": {
      "$value": "0 1px 2px rgba(0,0,0,0.3)",
      "$type": "shadow"
    },
    "md": {
      "$value": "0 4px 12px rgba(0,0,0,0.4)",
      "$type": "shadow"
    },
    "lg": {
      "$value": "0 12px 32px rgba(0,0,0,0.5)",
      "$type": "shadow"
    }
  }
}
