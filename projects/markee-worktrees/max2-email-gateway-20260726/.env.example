# PostgreSQL
DATABASE_URL=postgresql+asyncpg://markee:markee_dev@db:5432/markee
DB_PASSWORD=markee_dev

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# EUIPO API
EUIPO_API_CLIENT_ID=
EUIPO_API_CLIENT_SECRET=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (transactional gateway)
EMAIL_PROVIDER=memory
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=markee <no-reply@markee.pt>
SMTP_USE_TLS=true
SMTP_TIMEOUT=10
ALLOWED_FROM_ADDRESSES=["no-reply@markee.pt"]
EMAIL_VERIFY_TTL_MINUTES=1440
EMAIL_VERIFY_RATE_LIMIT_PER_HOUR=5
EMAIL_VERIFICATION_URL_BASE=http://localhost:8000
VERIFICATION_URL_ALLOWED_BASES=["http://localhost:8000","http://127.0.0.1:8000"]

# Telegram
TELEGRAM_BOT_TOKEN=

# Security
SECRET_KEY=change-me-in-production-32-characters-plus

# API base URL (for Streamlit to reach FastAPI)
API_BASE_URL=http://app:8000
