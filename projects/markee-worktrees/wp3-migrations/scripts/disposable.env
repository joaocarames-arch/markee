# Disposable PostgreSQL target for WP3 dry-run.
# This file is read by the proof scripts; it must NEVER be edited to point at
# the live Markee deployment. The target guard in scripts/target_guard.py is
# the single source of truth — any deviation aborts with GuardError.
WP3_DATABASE_URL=postgresql+asyncpg://markee_wp3:markee_wp3_local_only@127.0.0.1:5441/markee_wp3_disposable
WP3_DATABASE_URL_SYNC=postgresql://markee_wp3:markee_wp3_local_only@127.0.0.1:5441/markee_wp3_disposable
WP3_CONTAINER=markee-wp3-disposable-db-1
WP3_PORT=5441
WP3_HOST=127.0.0.1
WP3_USER=markee_wp3
WP3_DB=markee_wp3_disposable
WP3_PASSWORD=markee_wp3_local_only
